# Copier ce fichier en .env puis renseigner les valeurs.
# Le fichier .env ne doit JAMAIS être versionné.

# --- Django ---
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# True en développement uniquement, False en production
DEBUG=True
# Séparés par des virgules, ex : stockflow.onrender.com,www.stockflow.bj
ALLOWED_HOSTS=localhost,127.0.0.1
# Obligatoire en production derrière HTTPS, ex : https://stockflow.onrender.com
CSRF_TRUSTED_ORIGINS=
# URL publique, utilisée pour les liens dans les emails
SITE_URL=

# --- Base de données ---
# Développement : sqlite:///db.sqlite3
# Production    : postgres://utilisateur:motdepasse@hote:5432/nom_base
DATABASE_URL=sqlite:///db.sqlite3

# --- Email ---
# Développement : django.core.mail.backends.console.EmailBackend (affiche dans le terminal)
# Production    : django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Gmail : smtp.gmail.com / 587 / TLS   —   Brevo : smtp-relay.brevo.com / 587 / TLS
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
# Ne jamais écrire ce mot de passe ailleurs que dans le .env local
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=stockflow@localhost

# --- Alertes ---
# Adresse du gérant : reçoit les alertes de stock bas et le rapport quotidien
ALERTE_EMAIL_DESTINATAIRE=

# --- Production uniquement (valeurs par défaut sûres si absentes) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
